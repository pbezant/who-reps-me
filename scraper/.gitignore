node_modules/
# data/ holds scratch/per-run output (problems.json, probe.json, discover-jurisdictions' own
# cursor file) that shouldn't be committed — except data/jurisdictions/ (committed reference
# data, see scripts/build-jurisdiction-universe.js) and data/llm-usage.json (the committed daily
# LLM-call ledger run-daily.yml's phases read/write across the same job — see
# src/usage-ledger.js), so only ignore data/'s direct children and explicitly re-include those.
# (Negating files inside an ignored directory doesn't work in gitignore — the directory itself
# must not be ignored — hence `data/*` here rather than `data/`.)
data/*
!data/jurisdictions
!data/llm-usage.json
.env
